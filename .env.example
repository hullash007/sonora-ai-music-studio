# Local fixture configuration example. No real credentials belong in this file.
# Copy to .env for your notes if useful; .env is ignored by Git.
# IMPORTANT: Sonora does not auto-load .env. Export values in the shell that
# starts scripts/run_local_studio.py, or use your own environment-file loader.
# Leaving this unset selects the published local-only demo password.
# SONORA_LOCAL_PASSWORD=replace-with-your-own-local-development-value

# Advanced hosted adapter inputs. These are placeholders, not a working deploy.
# Do not source these unchanged or assume they configure every adapter setting.
# Missing image-preparation assets and fixed adapter values are documented in
# docs/setup.md and infra/modal/deployment.example.json.
# SONORA_GOOGLE_CLIENT_ID=your-oauth-web-client-id.apps.googleusercontent.com
# SONORA_OWNER_EMAIL=operator@example.com
# SONORA_ARCHIVE_GUARD=your-own-existing-archive-guard-dict
# SONORA_ARCHIVE_RUN_ID=your-own-existing-archive-run-uuid
# SONORA_ARCHIVE_JOB_ID=your-own-existing-archive-job-uuid
# SONORA_VALIDATED_DURATIONS=30
# SONORA_OWNER_VALIDATE_120=0

# Modal authentication belongs in your own CLI profile/provider secret store,
# never in a committed .env file. The hosted portal's PORTAL_PASSWORD secret is
# separate from SONORA_LOCAL_PASSWORD. Do not reuse the published demo password.
